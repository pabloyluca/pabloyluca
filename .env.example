# Local: npm run sandbox:setup creates random passwords in ignored .env.local.
COMMERCE_MODE=sandbox
APP_URL=http://127.0.0.1:3217
PABLO_DATA_DIR=
PABLO_UPLOAD_DIR=
SANDBOX_OWNER_EMAIL=
SANDBOX_OWNER_PASSWORD=
SANDBOX_KITCHEN_EMAIL=
SANDBOX_KITCHEN_PASSWORD=
SANDBOX_SESSION_SECRET=

# Existing Supabase project. Use the transaction pooler with a server-only role.
DATABASE_URL=
# Optional PEM if the project uses a private CA.
DATABASE_CA_CERT=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Mercado Pago Checkout Pro. Keep the test and production credentials separate.
MP_ENVIRONMENT=test
MP_TEST_ACCESS_TOKEN=
MP_TEST_WEBHOOK_SECRET=
MP_TEST_COLLECTOR_ID=
MP_PROD_ACCESS_TOKEN=
MP_PROD_WEBHOOK_SECRET=
MP_PROD_COLLECTOR_ID=
ENABLE_REAL_PAYMENTS=false

# A verified sending domain is required. Proton is the operational inbox.
RESEND_API_KEY=
RESEND_FROM=
ENABLE_TRANSACTIONAL_MAIL=false
CRON_SECRET=

# Future channel. No public inbound or outbound WhatsApp route in V1.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
